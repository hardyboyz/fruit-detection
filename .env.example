# ---- Database ----
# Defaults to a local SQLite file (backend/fruits.db).
# Point at Postgres instead, e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/fruits
#DATABASE_URL=sqlite:///./fruits.db

# ---- Uploads ----
#UPLOAD_DIR=./storage/uploads
#SAVE_UPLOADS=true
#MAX_UPLOAD_MB=12

# ---- YOLO ----
# Drop a dedicated fruit YOLO model in backend/models/ (any *.pt file) and it is
# picked up automatically. Or point at one explicitly:
#YOLO_WEIGHTS=/absolute/path/to/fruit_yolo.pt
# Fallback when no custom fruit model exists (COCO model, auto-downloaded):
#YOLO_FALLBACK_WEIGHTS=yolov8n.pt
#CONF_THRESHOLD=0.25
#IOU_THRESHOLD=0.45
#IMGSZ=640
# "" = auto-detect, or "cpu" / "mps" (Apple) / "0" (CUDA)
#YOLO_DEVICE=

# ---- CORS ----
#CORS_ORIGINS=*
